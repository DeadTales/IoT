# Conexión a PostgreSQL.
DATABASE_URL=postgresql://monitor_aire:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/monitor_aire

# Firma y duración de las sesiones del panel.
JWT_SECRET=
SESSION_MINUTES=480
COOKIE_SECURE=false

# Broker MQTT y recepción de mensajes del ESP32.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=monitor-aire-dashboard
MQTT_CONVERT_RAW=true

# Token compartido con los ESP32 para subir CSV por HTTP. Vacío deshabilita esta ruta.
CSV_UPLOAD_TOKEN=
