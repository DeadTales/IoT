# Reglas de edición para los archivos fuente del proyecto.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.{svelte,js,css,html,json}]
indent_size = 2
trim_trailing_whitespace = true

[*.{py,sql,cpp,h,ini}]
indent_size = 4
trim_trailing_whitespace = true

[*.{conf,example}]
trim_trailing_whitespace = true
